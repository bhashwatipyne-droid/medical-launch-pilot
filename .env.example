# Supabase project (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://occiztgbyxtslbuhtavb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Server only. Needed by the Team page and scripts/seed-admin.mjs to create sign-ins. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Browser push notifications (Firebase Cloud Messaging). Optional: leave all of these empty and the
# app works without push. Firebase console > Project settings.
# General > Your apps > Web app (the config snippet):
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Cloud Messaging > Web Push certificates > Key pair (public key):
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Server only. Service accounts > Generate new private key: paste the JSON file as one line, or
# base64-encode it. Mark Sensitive. Without it nothing is sent.
FIREBASE_SERVICE_ACCOUNT=
